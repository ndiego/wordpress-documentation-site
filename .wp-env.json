{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "https://wordpress.org/wordpress-7.1.3.zip",
	"phpVersion": "8.3",
	"port": 8889,
	"testsEnvironment": false,
	"plugins": [
		"./plugins/wporg-markdown",
		"./plugins/wp-docs",
		"https://downloads.wordpress.org/plugin/jetpack.16.3.1.zip",
		"https://downloads.wordpress.org/plugin/code-syntax-block.3.2.1.zip"
	],
	"themes": [
		"./themes/wp-docs"
	],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": "/tmp/wp-errors.log",
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": false,
		"JETPACK_DEV_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": "local",
		"WP_DOCS_MANIFEST": "/var/www/html/wp-content/wp-docs-content/manifest.json",
		"WP_DOCS_PREFER_LOCAL": true,
		"WP_DOCS_WEBHOOK_SECRET": "local-webhook-secret"
	},
	"mappings": {
		"wp-content/wp-docs-content": "../wordpress-documentation",
		"wp-docs-tools": "./tools/env",
		".htaccess": "./tools/env/.htaccess"
	}
}
