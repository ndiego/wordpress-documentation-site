--- a/inc/class-importer.php
+++ b/inc/class-importer.php
@@ -479,9 +479,29 @@
 		$etag = wp_remote_retrieve_header( $response, 'etag' );
 
 		$markdown = wp_remote_retrieve_body( $response );
-		// Strip YAML doc from the header
-		$markdown = preg_replace( '#^---(.+)---#Us', '', $markdown );
+
+		// Drop a UTF-8 byte order mark, which made `^---` miss the front matter.
+		if ( 0 === strncmp( $markdown, "\xEF\xBB\xBF", 3 ) ) {
+			$markdown = substr( $markdown, 3 );
+		}
+
+		// Strip YAML front matter: a `---` line at the very start, closed by the next line that is
+		// exactly `---` or `...`. A `---` inside a value no longer ends the block early.
+		$front_matter = '';
+		if ( preg_match( '/\A---[ \t]*\r?\n(.*?)^(?:---|\.\.\.)[ \t]*(?:\r?\n|\z)/ms', $markdown, $fm ) ) {
+			$front_matter = $fm[1];
+			$markdown     = substr( $markdown, strlen( $fm[0] ) );
+		}
 
+		/**
+		 * Fires with the raw front matter of an imported document, before the Markdown is parsed.
+		 *
+		 * @param string $front_matter YAML text without the fences ('' when absent).
+		 * @param int    $post_id      Post being updated.
+		 * @param string $post_type    Post type.
+		 */
+		do_action( 'wporg_markdown_front_matter', $front_matter, $post_id, $this->get_post_type() );
+
 		$markdown = trim( $markdown );
 
 		$markdown = apply_filters( 'wporg_markdown_before_transform', $markdown, $this->get_post_type() );
